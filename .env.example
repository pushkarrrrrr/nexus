# ==============================================================================
# NEXUS Environment Configuration
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Application Environment (development, staging, production, test)
NEXUS_ENV=development
LOG_LEVEL=INFO

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,tauri://localhost

# Database Configuration (PostgreSQL with pgvector; SQLite fallback used if offline)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexus
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./.nexus/nexus.db
DATABASE_ECHO=false

# Redis Configuration (Used for async worker queues and caching)
REDIS_URL=redis://localhost:6379/0

# AI Provider Gateway (Leave blank or set to your preferred provider)
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Security & Permissions
ENCRYPTION_KEY=nexus-development-secret-key-change-in-production
SESSION_EXPIRY_HOURS=24
AUTO_APPROVE_LOW_RISK=true
