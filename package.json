{
  "name": "nexus-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "NEXUS Agentic AI Operating System Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:dashboard": "npm run --workspace=@nexus/dashboard dev",
    "dev:ambient": "npm run --workspace=@nexus/ambient dev",
    "dev:tauri": "npm --workspace=@nexus/ambient exec -- tauri dev",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "npm run --workspaces --if-present lint"
  },
  "keywords": [
    "agentic-ai",
    "operating-system",
    "tauri",
    "nextjs",
    "fastapi"
  ],
  "author": "NEXUS Engineering Team",
  "license": "UNLICENSED"
}
